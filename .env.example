# Set ONE of these AI keys (Gemini and Groq have free tiers):
GEMINI_API_KEY=        # free at https://aistudio.google.com/apikey  (recommended: handles long videos)
GROQ_API_KEY=          # free at https://console.groq.com/keys       (fast, but its free tier only fits ~30-minute videos)
ANTHROPIC_API_KEY=     # paid, https://console.anthropic.com

# Optional: pick a service when several keys are set (gemini | groq | anthropic), or override its model.
# VIRALCUT_PROVIDER=gemini
# VIRALCUT_MODEL=gemini-flash-latest

# Optional: require this code before anyone can use your deployment (protects your API quota).
VIRALCUT_ACCESS_CODE=
